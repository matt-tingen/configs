#!/bin/zsh
# Clone <url> into a bare-repo + worktree layout.
#
#   <target>/
#   ├── .bare/       (the bare repo)
#   └── <default>/   (worktree of the remote's default branch)
#
# Usage: git bare-clone <url> [target-dir]

# Consider an existing tool if this expands much more
# e.g. https://github.com/ahmedelgabri/git-wt
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "usage: git bare-clone <url> [target-dir]" >&2
    exit 1
fi

url=$1
target=${2:-$(basename "$url" .git)}

if [[ -e $target ]]; then
    echo "error: $target already exists" >&2
    exit 1
fi

mkdir -p "$target"
cd "$target"

git init --bare .bare
git --git-dir=.bare config core.repositoryformatversion 1
git --git-dir=.bare config extensions.relativeworktrees true
git --git-dir=.bare config worktree.userelativepaths true
git --git-dir=.bare config fetch.prune true

git --git-dir=.bare remote add origin "$url"
git --git-dir=.bare fetch origin
git --git-dir=.bare remote set-head origin -a

default=$(git --git-dir=.bare symbolic-ref --short refs/remotes/origin/HEAD | sed 's|^origin/||')

git --git-dir=.bare symbolic-ref HEAD "refs/heads/$default"
git --git-dir=.bare branch --track "$default" "origin/$default"
git --git-dir=.bare worktree add "$default" "$default"

echo "Cloned $url into $(pwd)"
echo "Default worktree: $(pwd)/$default (tracks origin/$default)"
