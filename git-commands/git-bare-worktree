#!/bin/zsh
# Create a new worktree in a bare-repo layout, branched off the default branch.
#
# Equivalent to:
#   git -C <root>/<default> pull --ff-only
#   git -C <root>/<default> worktree add -b <branch> <root>/<branch> <default>
#
# Usage: git bare-worktree <branch>
#
# Run from anywhere inside the bare-repo layout (the root containing .bare/,
# or any worktree of it).

set -euo pipefail

if [[ $# -ne 1 ]]; then
    echo "usage: git bare-worktree <branch>" >&2
    exit 1
fi

branch=$1

# Locate the bare repo. From any worktree, --git-common-dir points to .bare/.
# From the root, .bare/ is a direct child.
if [[ -d .bare ]]; then
    bare=${PWD}/.bare
else
    bare=${$(git rev-parse --git-common-dir):A}
fi

if [[ ${bare:t} != .bare ]]; then
    echo "error: not in a bare-repo layout (expected .bare/ as the git dir)" >&2
    exit 1
fi

root=${bare:h}
# Prefer the remote's tracked default (refs/remotes/origin/HEAD) over the bare repo's local
# HEAD, which can drift to a non-existent branch depending on how the repo was initialized.
# Fall back to local HEAD if origin/HEAD isn't set.
if origin_head=$(git --git-dir="$bare" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); then
    default=${origin_head#origin/}
else
    default=$(git --git-dir="$bare" symbolic-ref --short HEAD)
fi
main_wt=$root/$default
new_wt=$root/$branch

if [[ ! -d $main_wt ]]; then
    echo "error: default-branch worktree not found at $main_wt" >&2
    exit 1
fi

if [[ -e $new_wt ]]; then
    echo "error: $new_wt already exists" >&2
    exit 1
fi

git -C "$main_wt" pull --ff-only
git -C "$main_wt" worktree add -b "$branch" "$new_wt" "$default"

if command -v zoxide >/dev/null 2>&1; then
    zoxide add "$new_wt"
fi

echo "Created worktree: $new_wt (branched off $default)"
