{
  // #region Telemetry
  "ecdc.collectTelemetry": false,
  "gitlens.advanced.telemetry.enabled": false,
  "partialDiff.enableTelemetry": false,
  "redhat.telemetry.enabled": false,
  "telemetry.telemetryLevel": "off",
  // #endregion

  // #region Workarounds
  // https://github.com/microsoft/TypeScript/issues/47302
  // "javascript.preferences.jsxAttributeCompletionStyle": "none",
  // "typescript.preferences.jsxAttributeCompletionStyle": "none",
  // #endregion

  // #region Configuration
  "files.exclude": {
    ".vscode/.chrome": true,
    ".*cache": true,
  },
  "search.exclude": {
    ".ignore/**": true,
    "**/CHANGELOG.md": true,
    "**/bower_components": false,
    "**/bower_components/**": true,
    "**/node_modules": false,
    "**/node_modules/**": true,
    "**/.*cache": true,
    "**/jest-cache": true,
    "**/dist/**": true,
    "**/tsconfig.tsbuildinfo": true,
  },
  "colorInfo.languages": [
    {
      "selector": "css",
      "colors": "css",
    },
    {
      "selector": "sass",
      "colors": "css",
    },
    {
      "selector": "scss",
      "colors": "css",
    },
    {
      "selector": "less",
      "colors": "css",
    },
  ],
  "files.associations": {
    ".*rc": "jsonc",
    ".sequelizerc": "javascript",
    ".pylintrc": "ini",
    ".djsrc": "ini",
    ".bashrc": "shellscript",
    ".zshrc": "shellscript",
    ".envrc": "shellscript",
    ".npmrc": "plaintext",
    ".nvmrc": "plaintext",
    ".yarnrc": "plaintext",
    ".lnk": "xml",
  },
  "emmet.includeLanguages": {
    "postcss": "css",
  },
  "emmet.syntaxProfiles": {
    "postcss": "css",
  },
  "terminal.external.osxExec": "Iterm.app",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "workbench.editorAssociations": {
    "git-rebase-todo": "default",
  },
  "go.toolsManagement.autoUpdate": true,
  // #endregion

  // #region Language-Specific
  "[git-commit]": {
    "editor.rulers": [50, 72],
    "rewrap.wrappingColumn": 72,
  },
  "[git-rebase]": {
    "editor.rulers": [50, 72],
  },
  "[plaintext]": {
    "editor.wordWrap": "bounded",
    "editor.wrappingIndent": "same",
    "editor.wordWrapColumn": 120,
  },
  "[markdown]": {
    // https://github.com/microsoft/vscode/issues/165232#issuecomment-1304203167
    "editor.bracketPairColorization.enabled": false,
  },
  "[graphql]": {
    "editor.rulers": [120],
    "rewrap.wrappingColumn": 120,
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
  },
  // #endregion

  // #region Tanium
  "plantuml.render": "PlantUMLServer",
  "plantuml.server": "https://plantuml.corp.tanium.com",
  // #endregion

  "workbench.colorTheme": "Dark Modern",
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "editor.tabSize": 2,
  "editor.tokenColorCustomizations": {
    "[Default Dark+]": {
      "textMateRules": [
        {
          "scope": "meta.decorator",
          "settings": {
            "fontStyle": "italic",
          },
        },
        {
          "scope": "punctuation.decorator",
          "settings": {
            "foreground": "#569CD6",
          },
        },
        // https://github.com/microsoft/vscode/issues/97373#issuecomment-626832698
        {
          "scope": ["variable.other.constant", "variable.other.enummember"],
          "settings": { "foreground": "#9CDCFE" },
        },
      ],
    },
  },
  "explorer.autoReveal": false,
  "workbench.sideBar.location": "left",
  "files.trimTrailingWhitespace": true,
  "terminal.integrated.fontSize": 12,
  "editor.rulers": [80, 120],
  "rewrap.wrappingColumn": 80,

  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  "git.blame.editorDecoration.enabled": true,
  "git.blame.editorDecoration.template": "${authorName}, ${authorDateAgo} · ${subject}",
  "git.blame.statusBarItem.template": "${authorName} (${authorDate})",
  "gitblame.statusBarMessageClickAction": "Open tool URL",
  "gitblame.statusBarMessageFormat": "${commit.hash_short,8} (${committer.date})",
  "gitblame.inlineMessageFormat": "${author.name}, ${time.c_ago} · ${commit.summary}",
  "gitblame.currentUserAlias": "You",

  "editor.formatOnSave": true,
  "gitlens.advanced.messages": {
    "suppressCommitHasNoPreviousCommitWarning": false,
    "suppressCommitNotFoundWarning": false,
    "suppressFileNotUnderSourceControlWarning": false,
    "suppressGitVersionWarning": false,
    "suppressLineUncommittedWarning": false,
    "suppressNoRepositoryWarning": false,
  },
  "chat.commandCenter.enabled": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "workbench.layoutControl.enabled": false,
  "workbench.editor.enablePreview": false,
  "biome.suggestInstallingGlobally": false,
  "python.disablePromptForFeatures": ["pylint"],
  "extensions.ignoreRecommendations": true,
  "git.autofetch": true,
  "workbench.statusBar.feedback.visible": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "breadcrumbs.enabled": true,
  "workbench.startupEditor": "newUntitledFile",
  "scrollkey.line1": 5,
  "scrollkey.line2": 20,
  "scrollkey.line3": 100,
  "workbench.editor.showTabs": "multiple",
  "cssModules.camelCase": true,
  "window.title": "${rootName}${separator}${activeEditorMedium}",
  "prettier.requireConfig": true,
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "merge-conflict.diffViewPosition": "Below",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "editor.minimap.size": "fill",
  "editor.scrollPredominantAxis": true,
  "emmet.showAbbreviationSuggestions": false,
  "emmet.showExpandedAbbreviation": "never",
  "workbench.editor.empty.hint": "hidden",
  "terminal.integrated.tabs.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "eslint.rules.customizations": [
    { "rule": "*", "fixable": true, "severity": "off" },
    { "rule": "*", "fixable": false, "severity": "warn" },
    { "rule": "jest/expect-expect", "severity": "off" },
  ],
  "workbench.editor.languageDetection": false,
  "editor.guides.bracketPairs": true,
  "scm.showActionButton": false,
  "workbench.editor.navigationScope": "editor",
  "editor.guides.indentation": true,
  "jumpy.primaryCharset": "qwerasdfzxcvuiopjklnmtyghb",
  "jumpy.display.backgroundColor": "#eee",
  "jumpy.display.color": "#444",
  "jest.autoEnable": false,
  "workbench.editor.decorations.badges": true,
  "workbench.editor.decorations.colors": false,
  "window.dialogStyle": "native",
  "window.commandCenter": false,
  "editor.snippetSuggestions": "none",
  "problems.sortOrder": "position",
  "editor.suggest.showSnippets": false,
  "git.showUnpublishedCommitsButton": "never",
  "window.zoomLevel": 1,
  "window.confirmBeforeClose": "keyboardOnly",
  "gitlens.ai.experimental.generateCommitMessage.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "scm.showIncomingChanges": "never",
  "scm.showOutgoingChanges": "never",
  "workbench.tree.enableStickyScroll": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact",
  ],
  "workbench.editor.customLabels.patterns": {
    "**/index.*": "/${dirname}.${extname}",
  },

  "typescript.tsserver.experimental.useVsCodeWatcher": false,
  "cursor-retrieval.canAttemptGithubLogin": false,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://biomejs.dev": true,
  },
  "biome.lsp.trace.server": "verbose",
  "claudeCode.preferredLocation": "panel",
  "chat.disableAIFeatures": true,
  "claudeCode.hideOnboarding": true,
  "claudeCode.useTerminal": true,
  "mostRecentFile.pathStyle": "absolute",
}
